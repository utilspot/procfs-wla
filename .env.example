# Debug mode: builds and serves the admin page (admin.html) that switches the
# test server's fixture. On by default in dev, off for a build.
APP_DEBUG=

# Public path the app itself is served from, when it is not at the domain root.
# Equivalent to `npm run build --base-url=/proc`.
APP_BASE_URL=

# Base URL of the backend that serves the host files under /api/file, e.g.
# <base>/api/file/cpuinfo for /proc/cpuinfo. Leave empty (the default) to read
# them from under the path the app itself is served from (APP_BASE_URL above),
# which in dev means the Vite proxy forwards those routes to the mock server
# on :3001.
VITE_API_BASE_URL=

# Which captured machine the mock server serves — one choice for the whole of
# /proc. One of the directories under server/machines/ (container, desktop,
# raspberry-pi, server, vm), or `host` to read the real /proc on this computer.
# Leave unset and the first capture is served; switch it live on the admin page.
FIXTURE_MACHINE=

# Port of the mock server.
PORT=3001
